# Chỉ ghi TÊN biến — giá trị thật đặt trên Vercel (Project → Settings → Environment Variables).

# URL gốc của trang, không có "/" cuối. Dùng cho metadataBase, sitemap, robots và mã QR.
NEXT_PUBLIC_SITE_URL=

# URL gốc của backend amber-v4, không có "/" cuối. Form liên hệ gửi tới <URL>/api/public/contact.
# Dev mặc định http://localhost:3000; bản build production thiếu biến thì form tự khoá.
NEXT_PUBLIC_API_URL=
